{
  "compilerOptions": {
    "target": "es2021",
    "lib": ["es2021", "dom"],
    "module": "es2022",
    "moduleResolution": "bundler",
    "types": ["node"],
    "rootDir": "../..",
    "outDir": "./dist",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "declaration": true
  },
  "include": ["src/**/*.ts", "tests/types.ts"]
}
